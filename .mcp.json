{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY:-}"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.84"]
    },
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server@3.1.3"],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server@2.1.4", "--transport", "stdio"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "wikidata": {
      "type": "http",
      "url": "https://wd-mcp.wmcloud.org/mcp"
    },
    "mcp-geo": {
      "command": "npx",
      "args": ["-y", "@digestseo/mcp-geo@0.3.30"],
      "env": {
        "OPENAI_API_KEY": "${MCP_GEO_OPENAI_API_KEY:-}",
        "ANTHROPIC_API_KEY": "${MCP_GEO_ANTHROPIC_API_KEY:-}",
        "GEMINI_API_KEY": "${MCP_GEO_GEMINI_API_KEY:-}",
        "PERPLEXITY_API_KEY": "${MCP_GEO_PERPLEXITY_API_KEY:-}",
        "XAI_API_KEY": "${MCP_GEO_XAI_API_KEY:-}",
        "SERPAPI_API_KEY": "${MCP_GEO_SERPAPI_API_KEY:-}"
      }
    }
  }
}
